# PostgreSQL and a private PostgREST service provide application data.
DATABASE_URL=postgresql://uniquecreations_app:password@127.0.0.1:5432/uniquecreations
# Private loopback PostgREST service. Never expose its token to browser code.
DATABASE_API_URL=http://127.0.0.1:9191
DATABASE_API_TOKEN=
APP_ORIGIN=https://uniquecreations.co.in
MEDIA_ROOT=/var/www/uniquecreations/media

# Sends enquiry notifications and quotations to customers. Use an app password,
# never a normal mailbox password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
CONTACT_TO=ramesh.nagisetti@vitalitysoft.com
EMAIL_USER=avinash.rao.vitality@gmail.com
EMAIL_PASS=

# AI Website Assistant chatbot widget -- see the admin portal's "Install
# Chatbot" page for this business's real values.
NEXT_PUBLIC_CHATBOT_WIDGET_SRC=
NEXT_PUBLIC_CHATBOT_CLIENT_ID=
