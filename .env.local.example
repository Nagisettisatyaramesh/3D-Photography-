# Create a Supabase project at https://supabase.com, run supabase/schema.sql
# in its SQL editor, then copy these from Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Sends quotations to customers. Use an app password, never a normal mailbox password.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
EMAIL_USER=
EMAIL_PASS=

# AI Website Assistant chatbot widget -- see the admin portal's "Install
# Chatbot" page for this business's real values.
NEXT_PUBLIC_CHATBOT_WIDGET_SRC=
NEXT_PUBLIC_CHATBOT_CLIENT_ID=
